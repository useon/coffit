{
  "name": "coffit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @coffit/web dev",
    "build": "pnpm build:web",
    "build:web": "pnpm --filter @coffit/web build",
    "start": "pnpm start:web",
    "start:web": "pnpm --filter @coffit/web start",
    "lint": "pnpm --filter @coffit/web lint",
    "format": "pnpm --filter @coffit/web format",
    "format:check": "pnpm --filter @coffit/web format:check"
  },
  "packageManager": "pnpm@10.28.2"
}
